# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Groq (free AI — get key at console.groq.com)
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key

# Resend (email delivery)
RESEND_API_KEY=your_resend_api_key
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret
NEXT_PUBLIC_INBOUND_EMAIL_DOMAIN=inbound.example.com

# Twilio (SMS webhook + call recording)
# Account SID and Auth Token: https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gmail OAuth for connected inboxes
GOOGLE_MAIL_CLIENT_ID=your_google_client_id
GOOGLE_MAIL_CLIENT_SECRET=your_google_client_secret

# Microsoft Graph OAuth for Outlook connected inboxes
MICROSOFT_MAIL_CLIENT_ID=your_microsoft_client_id
MICROSOFT_MAIL_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_MAIL_TENANT_ID=common

# Secret for scheduled auto-sync endpoint
INBOX_SYNC_CRON_SECRET=replace_with_a_random_secret

# Secret for scheduled daily digest endpoint
DIGEST_CRON_SECRET=replace_with_a_random_secret

# Optional Slack / Teams webhook for medium/high incident alerts
INCIDENT_ALERT_WEBHOOK_URL=https://example.com/webhook
INCIDENT_ALERT_MIN_RISK=medium
