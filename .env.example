# Supabase Auth and database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public app URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fraud analysis
GROQ_API_KEY=
# Optional: the model used to evaluate message context. Default: qwen/qwen3.6-27b
GROQ_FRAUD_MODEL=qwen/qwen3.6-27b
OPENAI_API_KEY=

# Transactional and inbound email
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
NEXT_PUBLIC_INBOUND_EMAIL_DOMAIN=

# Connected Gmail inbox (not used for Google login)
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=

# Connected Outlook inbox (not used for Microsoft login)
MICROSOFT_MAIL_CLIENT_ID=
MICROSOFT_MAIL_CLIENT_SECRET=
MICROSOFT_MAIL_TENANT_ID=common

# Optional integrations
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
CALL_ANALYSIS_ENABLED=false
# Optional phone-number reputation provider. The URL may contain {phone}, or
# FeelsOdd appends ?phone= in E.164 format. Expected response: status, score,
# reports and source.
PHONE_REPUTATION_API_URL=
PHONE_REPUTATION_API_TOKEN=
INBOX_SYNC_CRON_SECRET=
DIGEST_CRON_SECRET=
INCIDENT_ALERT_WEBHOOK_URL=
INCIDENT_ALERT_MIN_RISK=high
